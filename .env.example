# Скопіюй у .env (у git не потрапляє). На Vercel ці змінні задаються в Settings → Environment Variables.

# База. Локально — з docker-compose.yml (npm run db:up). На проді — Neon / Vercel Postgres.
DATABASE_URL="postgresql://salesmachine:salesmachine_dev@localhost:5433/salesmachine"

# Фото з адмінки. Є токен Vercel Blob — фото йдуть у Blob (прод). Немає — у папку UPLOADS_DIR (локально).
BLOB_READ_WRITE_TOKEN=""
UPLOADS_DIR="./uploads"

# Повна адреса сайту: https → cookie входу лише по https
SITE_URL="http://localhost:3100"

# Заявки з форм у Telegram (необов'язково; без них заявки пишуться в лог сервера)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
